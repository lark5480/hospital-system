# 复制为 .env 后按需修改(local 默认已可跑,一般不用改)

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=hospital
PG_PASSWORD=hospital
PG_DB=hospital

# RabbitMQ
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ============================================================
# 以下为 R-36 / R-01 / R-03 / R-11 / R-34 / R-35 / R-60 / R-62 新增项
# (本地不配置也能跑通,生产必须逐项覆盖)
# ============================================================

# Redis(当前未启用密码;端口已在 docker-compose 中绑定回环)
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- 应用安全 ----------
# R-01 JWT 签名密钥:≥32 字节随机串,例如 `openssl rand -base64 48`。
# 未注入时:prod profile 启动即失败;非 prod 生成临时随机密钥并告警(重启后已签发 token 全失效)。
# R-11/R-34: hospital-notification-service 也要用**同一把**来校验 SSE ticket。
#   它未配置时:非 prod 放行 + WARN(仅本地开发,因 core 非 prod 会用随机密钥,两边必然不一致);
#   prod 未配置 → 启动失败。
APP_JWT_SECRET=

# R-03/R-62 服务间内部调用令牌(core ↔ file-service 必须完全一致)。
# R-62 起**网关不再参与**:原先网关有 /api/files/** 路由并代发该令牌,现已撤除
#   (网关默认 profile 即 permitAll,由它代发的令牌对匿名调用者不构成边界,
#    而 file-service 的 list 又会把 download 归属校验所需的 patientId 一并送出去)。
# 未注入时:file-service 在 prod profile 下启动即失败;非 prod 放行 + WARN(本地零配置可跑)。
# 生成示例:openssl rand -hex 32
FILE_INTERNAL_TOKEN=

# R-35 通知服务允许的跨域来源,逗号分隔。默认 http://localhost:* (仅本机开发,切勿使用 *)。
# 生产示例:CORS_ALLOWED_ORIGINS=https://his.example.com
CORS_ALLOWED_ORIGINS=http://localhost:*

# ---------- 其它 ----------
# R-60 报告 PDF 的中文字体文件路径(可选)。
# 留空时 ReportPdfGenerator 按候选列表自动探测:Windows(msyh / simhei) →
#   Linux(Noto Sans CJK / 文泉驿) → macOS(PingFang);
#   全都找不到则**降级**为内置字体并打印 WARN —— 不抛异常、PDF 仍可生成,但中文会显示为方框。
# 本机开发一般不用配(Windows / macOS 有系统字体);将来做镜像、或部署到 Linux 服务器 / CI
# 需要真正渲染中文 PDF 时,请显式指定,例如:
#   PDF_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
PDF_FONT_PATH=

# ============================================================
# 安全提醒(R-36):
#   1) docker-compose.yml 中各中间件端口已绑定 127.0.0.1,只允许本机访问。
#      原先直接映射 "5432:5432" 时,内网任何人用默认口令即可连上 PostgreSQL,
#      读到 patient.patient 的身份证明文以及 MinIO 里的全部报告文件。
#   2) 本文件与 compose 中的口令均为本地演示值,生产部署请勿沿用。
# ============================================================
