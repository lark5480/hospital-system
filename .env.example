# 复制为 .env 后按需修改(local 默认已可跑,一般不用改)

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=hospital
PG_PASSWORD=hospital
PG_DB=hospital

# RabbitMQ
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# 认证(自管 JWT,默认 dev 态零配置可跑)
# VITE_AUTH_ENABLED=true → 前端启用真登录(生产态)
