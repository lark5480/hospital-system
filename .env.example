# 医院系统 · 环境变量样例（R-36 / R-01 / R-03）
#
# 用法（本地开发）：
#   cp .env.example .env      # 然后按需修改
#   docker compose up -d      # docker compose 会自动读取同目录的 .env
#
# 注意：
#   1) .env 已在 .gitignore 中，不要提交真实口令。
#   2) 不改任何变量也能本地跑通 —— 下面都写了演示默认值，与 docker-compose.yml 一致。
#   3) 生产部署必须逐项覆盖，且绝不能沿用这里的演示值。

# ---------- PostgreSQL ----------
PG_HOST=localhost
PG_PORT=5432
PG_DB=hospital
PG_USER=postgres
# 演示值 root123；生产请用 openssl rand -base64 24 生成
PG_PASSWORD=root123

# ---------- Redis（当前未启用密码）----------
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- RabbitMQ ----------
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=admin
# 演示值 admin123
RABBIT_PASSWORD=admin123

# ---------- MinIO ----------
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
# 演示值 minioadmin；生产必须更换
MINIO_SECRET_KEY=minioadmin

# ---------- 应用安全（R-01 / R-03）----------
# JWT 签名密钥：≥32 字节随机串，例如 `openssl rand -base64 48`。
# 未注入时：prod profile 启动即失败；非 prod 生成临时随机密钥并告警（重启后 token 全失效）。
APP_JWT_SECRET=

# 服务间内部调用令牌（core / gateway ↔ file-service 必须完全一致）。
# 未注入时：file-service 在 prod profile 下启动即失败；网关使用占位串 dev-no-token。
# 生成示例：openssl rand -hex 32
FILE_INTERNAL_TOKEN=

# ---------- 前端跨域（R-35）----------
# 通知服务允许的跨域来源，逗号分隔。默认 http://localhost:*（仅本机开发）。
# 生产示例：CORS_ALLOWED_ORIGINS=https://his.example.com
CORS_ALLOWED_ORIGINS=http://localhost:*
